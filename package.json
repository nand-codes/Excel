{
  "name": "excel-driving-school",
  "version": "1.0.0",
  "description": "Excel Driving School — Client Management System (web app + API)",
  "main": "server/index.js",
  "scripts": {
    "server": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "build": "npm run web:build",
    "start": "node server/index.js",
    "user:add": "node scripts/user-cli.js add",
    "user:list": "node scripts/user-cli.js list",
    "user:passwd": "node scripts/user-cli.js passwd",
    "user:remove": "node scripts/user-cli.js remove",
    "backup:now": "node scripts/backup-snapshot.js",
    "test": "node scripts/api-smoke-test.js && node scripts/concurrency-test.js",
    "test:api": "node scripts/api-smoke-test.js",
    "test:concurrency": "node scripts/concurrency-test.js",
    "test:ui": "node scripts/ui-smoke-test.js",
    "perf": "node scripts/perf-benchmark.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nandana-suresh-c/Excel.git"
  },
  "keywords": [],
  "author": "Excel Driving School",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "bugs": {
    "url": "https://github.com/nandana-suresh-c/Excel/issues"
  },
  "homepage": "https://github.com/nandana-suresh-c/Excel#readme",
  "devDependencies": {
    "puppeteer-core": "^25.10.0"
  },
  "overrides": {
    "ip-address": "^10.7.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0"
  }
}
