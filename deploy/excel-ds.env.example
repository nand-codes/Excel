# Copy to /etc/excel-ds.env on the server, then: sudo chmod 640 /etc/excel-ds.env
# sudo chown root:excelds /etc/excel-ds.env

NODE_ENV=production

# Only Caddy talks to the API, so bind to localhost.
HOST=127.0.0.1
PORT=4000

# Kept outside /opt/excel-ds so a redeploy can never touch the database.
EXCEL_DB_PATH=/var/lib/excel-ds/clients.sqlite

EXCEL_WEB_DIST=/opt/excel-ds/web/dist

# Session cookie lifetime in days.
EXCEL_SESSION_DAYS=30

# Both are implied by NODE_ENV=production; listed here so they are obvious.
EXCEL_SECURE_COOKIES=1
EXCEL_TRUST_PROXY=1

# Sign-in attempts per IP per window.
EXCEL_LOGIN_ATTEMPTS=10
EXCEL_LOGIN_WINDOW_MINUTES=15

# Nightly backups. While EXCEL_S3_TARGET is unset the job still runs and still prunes,
# it just keeps the snapshots on the instance. Uncomment it with your own bucket name
# once the bucket and the IAM user from docs/DEPLOYMENT.md step 7 exist.
EXCEL_BACKUP_DIR=/var/backups/excel-ds
# EXCEL_S3_TARGET=s3://excel-ds-backups-yourname/snapshots
