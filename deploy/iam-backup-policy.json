{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PutEncryptedSnapshotsOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": "arn:aws:s3:::excel-ds-backups-CHANGEME/snapshots/*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-server-side-encryption": "AES256"
        }
      }
    }
  ]
}
