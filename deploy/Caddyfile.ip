# /etc/caddy/Caddyfile — the no-domain variant, served straight from the static IP.
# Replace 203.0.113.10 with your Lightsail static IP and admin@example.com with your email.
#
# Let's Encrypt does issue certificates for IP addresses, but only under the "shortlived"
# profile: 160 hours, about six days, instead of 90. Caddy renews them on its own, so the
# real cost is that ports 80 and 443 must stay reachable — if renewal fails two days
# running, HTTPS stops working. A domain name avoids that, and is worth the USD 12/year
# the first time it wakes you up.

{
	email admin@example.com

	# A browser sends no SNI when you type a bare IP, and on Lightsail the socket's local
	# address is the private NAT address rather than the public one. Without this, Caddy
	# hunts for a certificate named after the private address and the handshake fails.
	default_sni 203.0.113.10
}

https://203.0.113.10 {
	# ZeroSSL does not issue for IP addresses over ACME, so pin the issuer to Let's
	# Encrypt and ask for the only profile it allows for them.
	tls {
		issuer acme {
			email admin@example.com
			profile shortlived
		}
	}

	encode zstd gzip

	# The API. Everything under /api needs a session cookie, enforced by Node.
	handle /api/* {
		reverse_proxy 127.0.0.1:4000 {
			header_up X-Real-IP {remote_host}
		}
	}

	# The React build. Unknown paths fall back to index.html so deep links work.
	handle {
		root * /opt/excel-ds/web/dist
		try_files {path} /index.html
		file_server
	}

	# Vite writes content-hashed asset names, so they can be cached indefinitely.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	# No Strict-Transport-Security here: browsers ignore HSTS from an IP host, so
	# claiming it would be misleading rather than protective.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
		-Server
	}

	log {
		output file /var/log/caddy/excel-ds.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
